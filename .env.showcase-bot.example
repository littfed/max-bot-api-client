# MAX Bot API Access Token
MAX_BOT_TOKEN=your-max-bot-token-from-business.max.ru

# Go Model API Integration (GMA / OpenAI-compatible)
GMA_BASE_URL=https://gma.littfed.ru
GMA_API_KEY=app-key-1
GMA_CHAT_MODEL=gemini-2.5-flash
GMA_VISION_MODEL=gemini-2.5-flash
GMA_IMAGE_MODEL=flux
AI_CHAT_MODEL=gemini-2.5-flash

# HTTP Server Port (Webhooks / Mini App / Metrics)
PORT=8080

# Diagnostics & Active Chat Correlation
TEST_USER_ID=396393759
TEST_CHAT_ID=140396458

# Persistent SQL Store (PostgreSQL or SQLite)
# Examples:
#   DATABASE_URL=postgres://user:password@shared-postgres:5432/dbname?sslmode=disable
#   DATABASE_URL=sqlite://data/bot_store.db
# If empty, automatically falls back to data/bot_store.json
DATABASE_URL=postgres://user:password@shared-postgres:5432/dbname?sslmode=disable

# Distributed Redis Session Storage (FSM)
# Examples:
#   REDIS_URL=redis://:password@shared-redis:6379/0
#   REDIS_URL=redis://localhost:6379/0
# If empty or unreachable, automatically falls back to in-memory sessions
REDIS_URL=redis://:password@shared-redis:6379/0
