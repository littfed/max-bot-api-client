# ── Stage 1: Build React 18 SPA Frontend ───────────────────────────
FROM node:20-alpine AS web-builder

WORKDIR /web

# Copy package manifests and install dependencies
COPY web/package.json web/package-lock.jso[n] ./
RUN npm ci

# Copy web source and build production bundle into /web/dist
COPY web/ ./
RUN npm run build

# ── Stage 2: Build Showcase Bot Binary with Embedded Web Assets ────
FROM golang:alpine AS builder

ENV GOTOOLCHAIN=auto
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src

# Copy module manifests and pre-fetch Go dependencies
COPY go.mod ./
COPY go.su[m] ./
RUN go mod download

# Copy complete repository
COPY . .

# Copy compiled React SPA assets from web-builder into web/dist
COPY --from=web-builder /web/dist ./web/dist

# Build statically linked binary without CGO
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" \
    -o /bin/showcase-bot ./cmd/showcase-bot

# ── Stage 3: Minimal Distroless/Alpine Runtime ─────────────────────
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata ffmpeg

WORKDIR /app

# Run as non-root user
RUN adduser -D -g '' appuser

COPY --from=builder /bin/showcase-bot /app/showcase-bot

# Expose Mini App / Webhook / Health check HTTP port
EXPOSE 8080

ENV LOG_LEVEL=info

USER appuser

ENTRYPOINT ["/app/showcase-bot"]
CMD ["-port", "8080"]
