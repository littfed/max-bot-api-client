# ==============================================================================
# MAX AI Bot Configuration (.env)
# ==============================================================================

# Токен бота из личного кабинета разработчика MAX (https://dev.max.ru)
MAX_BOT_TOKEN=0123456789:abcdefghijklmnopqrstuvwxyz

# Базовый URL шлюза Go Model API (GMA)
GMA_BASE_URL=https://gma.littfed.ru

# Ключ авторизации в GMA (если включена авторизация на шлюзе)
GMA_API_KEY=

# Модель по умолчанию для обычного текстового чата
GMA_CHAT_MODEL=@scout

# Модель по умолчанию для анализа изображений и OCR
GMA_VISION_MODEL=@scout-vision

# Модель по умолчанию для генерации картинок (/image, /draw)
GMA_IMAGE_MODEL=flux
